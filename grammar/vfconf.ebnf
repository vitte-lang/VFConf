(* ============================================================
 * VFConf — Vitte Foundation Configuration Language
 * Canonical Grammar
 * File extension: *.vf.conf
 * ============================================================ *)

document        = { statement } ;

statement       = section
                | assignment
                | include
                | define
                | conditional
                ;

(* ---------- Sections ---------- *)

section         = "[", section_name, "]", newline,
                  { assignment | include | define | conditional } ;

section_name    = identifier, { ".", identifier } ;

(* ---------- Assignments ---------- *)

assignment      = key, assignment_op, value, terminator ;

assignment_op   = "=" | ":=" | "+=" | "-=" ;

key             = identifier, { ".", identifier } ;

(* ---------- Values ---------- *)

value           = string
                | integer
                | float
                | boolean
                | null
                | array
                | object
                | reference
                | color
                | duration
                | size ;

(* ---------- Primitive values ---------- *)

string          = quoted_string ;

quoted_string   = '"', { string_character | escape }, '"' ;

integer         = decimal_integer
                | hexadecimal_integer
                | octal_integer
                | binary_integer ;

decimal_integer = [ sign ], digits ;

hexadecimal_integer
                = ( "0x" | "0X" ), hex_digits ;

octal_integer   = ( "0o" | "0O" ), octal_digits ;

binary_integer  = ( "0b" | "0B" ), binary_digits ;

float           = [ sign ],
                  ( digits, ".", [ digits ], [ exponent ]
                  | ".", digits, [ exponent ]
                  | digits, exponent
                  ) ;

exponent        = ( "e" | "E" ), [ sign ], digits ;

sign            = "+" | "-" ;

boolean         = "true" | "false" | "on" | "off" ;

null            = "null" | "none" ;

(* ---------- Arrays ---------- *)

array           = "[",
                  [ value, { ",", value }, [ "," ] ],
                  "]" ;

(* ---------- Objects ---------- *)

object          = "{",
                  [ object_entry,
                    { ",", object_entry },
                    [ "," ]
                  ],
                  "}" ;

object_entry    = key, ":", value ;

(* ---------- References ---------- *)

reference       = "$", identifier,
                  { ".", identifier } ;

(* ---------- Includes ---------- *)

include         = "include", string, terminator ;

(* ---------- Definitions ---------- *)

define          = "define",
                  identifier,
                  "=",
                  value,
                  terminator ;

(* ---------- Conditional configuration ---------- *)

conditional     = "when",
                  condition,
                  "{",
                  { statement },
                  "}",
                  [ "else",
                    "{",
                    { statement },
                    "}"
                  ] ;

condition       = condition_or ;

condition_or    = condition_and,
                  { "||", condition_and } ;

condition_and   = condition_unary,
                  { "&&", condition_unary } ;

condition_unary = [ "!" ], condition_primary ;

condition_primary
                = reference
                | boolean
                | comparison
                | "(", condition, ")" ;

comparison      = reference,
                  comparison_op,
                  value ;

comparison_op   = "=="
                | "!="
                | "<"
                | "<="
                | ">"
                | ">=" ;

(* ---------- Theme values ---------- *)

color           = hex_color | rgb_color | rgba_color ;

hex_color       = "#", ( hex_color_3 | hex_color_4
                         | hex_color_6 | hex_color_8 ),
                  ? followed by a token boundary ? ;

hex_color_3     = hex_digit, hex_digit, hex_digit ;
hex_color_4     = hex_color_3, hex_digit ;
hex_color_6     = hex_color_3, hex_color_3 ;
hex_color_8     = hex_color_4, hex_color_4 ;

rgb_color       = "rgb",
                  "(",
                  integer, ",",
                  integer, ",",
                  integer,
                  ")" ;

rgba_color      = "rgba",
                  "(",
                  integer, ",",
                  integer, ",",
                  integer, ",",
                  float,
                  ")" ;

(* ---------- Units ---------- *)

duration        = number,
                  ( "ns"
                  | "us"
                  | "ms"
                  | "s"
                  | "min"
                  | "h"
                  ) ;

size            = number,
                  ( "B"
                  | "KB"
                  | "MB"
                  | "GB"
                  | "KiB"
                  | "MiB"
                  | "GiB"
                  ) ;

number          = integer | float ;

(* ---------- Identifiers ---------- *)

identifier      = identifier_start,
                  { identifier_continue } ;

identifier_start
                = letter | "_" ;

identifier_continue
                = letter
                | digit
                | "_"
                | "-" ;

(* ---------- Lexical rules ---------- *)

letter          = "A".."Z" | "a".."z" ;

digit           = "0".."9" ;

digits          = digit, { digit | "_" } ;

hex_digits      = hex_digit, { hex_digit | "_" } ;

octal_digits    = "0".."7", { "0".."7" | "_" } ;

binary_digits   = ( "0" | "1" ), { "0" | "1" | "_" } ;

hex_digit       = digit
                | "A".."F"
                | "a".."f" ;

escape          = "\\n"
                | "\\r"
                | "\\t"
                | "\\b"
                | "\\f"
                | "\\\\"
                | "\\/"
                | '\\"'
                | unicode_escape ;

unicode_escape  = "\\u", hex_digit, hex_digit, hex_digit, hex_digit ;

string_character
                = ? any Unicode character except '"', '\', CR and LF ? ;

(* ---------- Comments ---------- *)

comment         = line_comment | block_comment ;

line_comment    = "#", ? followed by newline or end of input ?
                | "#", horizontal_whitespace,
                       { ? character except newline ? }
                | "//", { ? character except newline ? } ;

block_comment   = "/*",
                  { ? character sequence except "*/" ? },
                  "*/" ;

(* ---------- Layout ---------- *)

terminator      = ";" | newline ;

newline         = "\n" | "\r\n" ;

whitespace      = " " | "\t" | newline ;

horizontal_whitespace
                = " " | "\t" ;

(* Comments and insignificant whitespace may occur between
 * lexical tokens unless they occur inside string literals. *)
